# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.
#
# Every key below is optional. Any provider without credentials is skipped, and
# the app falls back to seeded data for that category.

# --- Tickets ---------------------------------------------------------------

# Ticketmaster Discovery API — FREE, self-serve, no approval needed.
#   1. Sign up at https://developer-acct.ticketmaster.com/user/register
#   2. Your app is created automatically; copy the "Consumer Key"
#   3. Paste it below, then run: npm run check:providers
#
# Note: Discovery returns price RANGES, not seat-level listings. Seat-level
# inventory requires the partner programme (commercial agreement).
TICKETMASTER_API_KEY=

# SeatGeek — FREE, self-serve. Register an app at:
#   https://seatgeek.com/account/develop
# Better than Discovery for us: returns lowest AND average price plus a live
# listing count, i.e. real market depth. Still not seat-level.
# Check whether your tier returns pre-fee or all-in prices, then set
# ESTIMATED_FEE_RATE in src/lib/providers/tickets/seatgeek.ts to match.
SEATGEEK_CLIENT_ID=

# StubHub — partner approval required, not self-serve.
# STUBHUB_APP_TOKEN=

# --- Travel ----------------------------------------------------------------

# Live flight prices for the visitor's exact dates (Google Flights, read through
# SerpApi). Free plan: 250 searches a month. Sign up at https://serpapi.com,
# copy the API key from your dashboard and paste it after the = below.
SERPAPI_KEY=

# --- Stays -----------------------------------------------------------------

# Booking.com / Expedia require affiliate approval.

# Live flight prices for the trip total (free): sign up at https://www.travelpayouts.com,
# open Tools → API, copy your API token, and paste it after the = below.
# Save this file as .env.local (not .env.example), then restart the dev server.
TRAVELPAYOUTS_TOKEN=

# Ticketmaster and SeatGeek keys (above) also switch on live prices on each
# game page. For the live website, add the same values in Vercel → Project →
# Settings → Environment Variables, then redeploy.
